# ── Cortex Production Environment ────────────────────────────────
# Copy this to .env.production on your VPS and fill in real values.
# NEVER commit this file with real secrets.

# Domain
DOMAIN=cortex.ryvanai.com

# PostgreSQL
POSTGRES_USER=cortex
POSTGRES_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD

# Database connection (Docker internal network)
DATABASE_URL=postgresql://cortex:CHANGE_ME_USE_A_STRONG_PASSWORD@postgres:5432/cortex

# Auth
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32
NEXTAUTH_URL=https://cortex.ryvanai.com

# App
APP_VERSION=1.0.0
NODE_ENV=production

# Feature Flags (progressive rollout - enable one at a time)
FEATURE_DISCOVERY=true
FEATURE_INTELLIGENCE=true
FEATURE_EXECUTION=true
FEATURE_PROPOSALS=true
FEATURE_EMAIL_DRAFTS=true
FEATURE_EMAIL_SENDING=false
FEATURE_MEETING_AUTOMATION=false
# Set to true to let the daily autonomous cron run
FEATURE_CONTINUOUS_MONITORING=true
FEATURE_CRAWLER=false

# ── Autonomous AI SDR ────────────────────────────────────────────
# Accurate B2B data source (preferred). Free tier at thecompaniesapi.com.
THE_COMPANIES_API_KEY=CHANGE_ME
# Web-search fallback (optional). Free tier at serper.dev.
SERPER_API_KEY=

# Production LLM = Anthropic API (the VPS can't run Ollama). Add credit at
# console.anthropic.com, then paste the key. Without it, drafts fall back to a
# heuristic template. ~0.3c per email with Haiku 4.5.
ANTHROPIC_API_KEY=CHANGE_ME
ANTHROPIC_MODEL=claude-haiku-4-5

# Outreach identity + booking link (used in the cold-email drafts)
RYVAN_BOOKING_LINK=https://calendly.com/ryvantechnologies/30min
RYVAN_SENDER_NAME=Naveen Kumar Reddy
RYVAN_SENDER_TITLE=Co-Founder
RYVAN_SENDER_EMAIL=naveen@ryvanai.com
RYVAN_SENDER_PHONE=
RYVAN_LINKEDIN=

# ── Email (Resend) ──────────────────────────────────────────────
# Transactional email via Resend (resend.com). Required when
# FEATURE_EMAIL_SENDING=true. Add your domain in Resend dashboard
# for DKIM/SPF verification.
RESEND_API_KEY=re_CHANGE_ME
# Webhook signing secret (optional, from Resend dashboard → Webhooks)
RESEND_WEBHOOK_SECRET=

# ── Observability ───────────────────────────────────────────────
# Log level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# Daily cron secret (protects /api/cron/autonomous-discovery). Generate with:
#   openssl rand -hex 24
CRON_SECRET=CHANGE_ME
CRON_REPORTS_PER_RUN=5
