# RyvanOS configuration.
#
# Copy to .env and fill in. .env is gitignored; never commit real values.
# Generate each secret with:  openssl rand -base64 32

# --- required ---------------------------------------------------------------

# Signs session JWTs. Rotating it invalidates every issued token.
RYVAN_JWT_SECRET=

# Encrypts stored secrets (connector credentials, API keys) at rest.
# Losing this makes every stored secret unrecoverable — back it up somewhere
# the database backup is not, or it protects nothing.
RYVAN_SECRET_KEY=

# --- storage ----------------------------------------------------------------
# Omit RYVAN_POSTGRES_URL and the platform runs entirely in memory: correct for
# a quick look, data loss in production. Nothing survives a restart.

RYVAN_POSTGRES_URL=postgres://ryvan:ryvan_dev@localhost:5432/ryvan
RYVAN_REDIS_URL=redis://localhost:6379

# Lets several environments share one database.
RYVAN_TABLE_PREFIX=ryvan

# Must match the embedding model you use. Changing it after data exists
# requires re-embedding — the column width is fixed at creation.
RYVAN_VECTOR_DIMENSIONS=1536

# --- Developer Console ------------------------------------------------------
# Leave RYVAN_CONSOLE_TOKEN empty and no console starts. It exposes every
# mission's inputs, the audit trail, and the approval buttons, so it is opt-in.

RYVAN_CONSOLE_TOKEN=
RYVAN_CONSOLE_PORT=4500

# Binds loopback by default. Only set 0.0.0.0 when something in front of it
# terminates TLS and authenticates — inside Docker, compose already does this.
RYVAN_CONSOLE_HOST=127.0.0.1

# Mount prefix when sitting behind a reverse proxy, e.g. /console
RYVAN_CONSOLE_BASE_PATH=

# --- health -----------------------------------------------------------------
# Unauthenticated /healthz and /readyz, on their own port so a load balancer
# never needs the console token.
RYVAN_HEALTH_PORT=4501

# --- models -----------------------------------------------------------------
RYVAN_DEFAULT_MODEL=claude-haiku-4-5

# --- misc -------------------------------------------------------------------
RYVAN_LOG_LEVEL=info
POSTGRES_PASSWORD=ryvan_dev

# --- tests ------------------------------------------------------------------
# Integration tests skip when these are absent. CI sets them; set them locally
# to run the Postgres and Redis suites against real services.
RYVAN_TEST_POSTGRES_URL=postgres://ryvan:ryvan_dev@localhost:55432/ryvan_test
RYVAN_TEST_REDIS_URL=redis://localhost:56379
