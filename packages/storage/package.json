{
  "name": "@ryvan/storage",
  "version": "1.0.0",
  "description": "Ryvan Platform - Storage ports and drivers: key-value, document, object, and vector persistence",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/conformance.d.ts",
      "import": "./dist/conformance.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@ryvan/common": "workspace:*",
    "@ryvan/events": "workspace:*"
  },
  "peerDependencies": {
    "ioredis": "^5.4.0",
    "pg": "^8.13.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "ioredis": "^5.4.0",
    "pg": "^8.13.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
