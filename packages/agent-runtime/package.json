{
  "name": "@ryvan/agent-runtime",
  "version": "1.0.0",
  "description": "Ryvan Platform - OS scheduler managing agent task lifecycle, planning, scheduling, and execution",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@ryvan/common": "workspace:*",
    "@ryvan/events": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
